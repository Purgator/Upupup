<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/app_name" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Alarms tab -->
        <LinearLayout
            android:id="@+id/alarms_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Fixed-height, single-line next-alarm strip -->
            <TextView
                android:id="@+id/next_alarm_banner"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="?attr/colorPrimaryContainer"
                android:drawablePadding="8dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="14sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_alarm"
                app:drawableTint="?attr/colorOnPrimaryContainer"
                tools:text="Rings in 7h 32m  ·  07:30" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/alarm_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="96dp"
                tools:listitem="@layout/item_alarm" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0.6"
            android:drawablePadding="16dp"
            android:drawableTint="?attr/colorPrimary"
            android:gravity="center"
            android:text="@string/no_alarms"
            android:textSize="18sp"
            android:visibility="gone"
            app:drawableTopCompat="@drawable/ic_alarm" />

        <!-- Timer tab -->
        <LinearLayout
            android:id="@+id/timer_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <!-- Not running: composed duration + preset buttons -->
            <TextView
                android:id="@+id/timer_compose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="sans-serif-thin"
                android:textSize="64sp"
                tools:text="25:00" />

            <!-- match_parent is load-bearing: the buttons are width-0 with column
                 weights, and GridLayout only distributes weight from excess space. -->
            <GridLayout
                android:id="@+id/timer_presets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:columnCount="3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/timer_clear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/timer_clear"
                android:visibility="gone" />

            <!-- Where the timer rings: automatic / speaker / wired / bluetooth.
                 Tapping selects immediately; no confirmation. -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/timer_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/timer_output_auto"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/output_auto"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_sound"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="32dp" />

                <Button
                    android:id="@+id/timer_output_speaker"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/output_speaker"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_speaker"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="32dp" />

                <Button
                    android:id="@+id/timer_output_wired"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/output_wired"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_headphones"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="32dp" />

                <Button
                    android:id="@+id/timer_output_bluetooth"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/output_bluetooth"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_bluetooth"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="32dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/timer_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:fontFamily="sans-serif-thin"
                android:textSize="64sp"
                android:visibility="gone"
                tools:text="09:41" />

            <TextView
                android:id="@+id/timer_end_at"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                tools:text="Rings at 15:32" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/timer_button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="8dp"
                android:text="@string/timer_start"
                android:textSize="20sp"
                app:cornerRadius="32dp" />
        </LinearLayout>

        <!-- Stopwatch tab -->
        <LinearLayout
            android:id="@+id/stopwatch_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/stopwatch_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:fontFamily="monospace"
                android:text="00:00.0"
                android:textSize="60sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lap_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                tools:listitem="@android:layout/simple_list_item_1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stopwatch_lap"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/stopwatch_reset"
                    app:cornerRadius="32dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stopwatch_toggle"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="@string/timer_start"
                    android:textSize="18sp"
                    app:cornerRadius="32dp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="@string/add_alarm"
            app:srcCompat="@drawable/ic_add" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:itemIconTint="@color/bottom_nav_tint"
        app:itemTextColor="@color/bottom_nav_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav" />

</LinearLayout>
