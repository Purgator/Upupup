<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light: warm cream surfaces with a terracotta accent -->
    <style name="Theme.Upupup" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:colorBackground">@color/surface_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest_light</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low_light</item>
        <item name="colorSurfaceContainer">@color/surface_container_light</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high_light</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_light</item>
        <item name="android:statusBarColor">@color/surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Ring screen: dark, edge to edge, over the lock screen. -->
    <style name="Theme.Upupup.Ring" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/ring_background</item>
        <item name="android:navigationBarColor">@color/ring_background</item>
        <item name="android:windowBackground">@color/ring_background</item>
        <item name="colorPrimary">#FF8F2E</item>
        <item name="colorOnPrimary">#3A1D00</item>
    </style>
</resources>
